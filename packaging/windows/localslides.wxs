<?xml version="1.0" encoding="utf-8"?>
<!--
  Local Slides MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus its UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2` and the same for WixToolset.Util.wixext).
  Built by package.ps1:

    wix build localslides.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -d Version=1.2.3 -d BinDir=... -d IconPath=... -d LicenseRtf=...
      [-d Scope=perUserOrMachine] -o out.msi

  Per-machine install into Program Files\Local Slides with Start Menu and desktop shortcuts. The
  installer shows the standard WiX dialogs: welcome + license, progress, and a finish page.

  Built a second time with -d Scope=perUserOrMachine for people without administrator rights: a
  dual-purpose package that WiX gives ALLUSERS=2 and MSIINSTALLPERUSER=1, so it installs for the
  current user with no UAC prompt. Windows then redirects Program Files to
  %LOCALAPPDATA%\Programs, the Start Menu to the user's own, and HKMU to HKCU, so the same
  components work in both packages. Both share the UpgradeCode: each upgrades its own earlier
  versions (Windows Installer only matches products installed in the same context).

  UpgradeCode and the component GUIDs below belong to Local Slides alone. Never copy them from (or
  into) a sibling Local app: Windows Installer treats every package sharing an UpgradeCode as one
  product, so a shared code makes one app's installer refuse to install ("a newer version is
  already installed") or silently uninstall the other.
-->
<?ifndef Scope?>
<?define Scope = perMachine?>
<?endif?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif?>
  <Package
      Name="Local Slides"
      Manufacturer="Local Slides contributors"
      Version="$(var.Version)"
      UpgradeCode="8C3D9B21-6E4A-4F57-9B0C-2A7E5D4F1B63"
      Scope="$(var.Scope)"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Local Slides presentations and slide shows" Manufacturer="Local Slides contributors" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Local Slides is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="LocalSlidesIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="LocalSlidesIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Anon5T4R/local-slides" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/Anon5T4R/local-slides/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Anon5T4R/local-slides/issues" />

    <!-- Installer UI: WixUI_Minimal is welcome + license, progress, then a finish page so people
         can see the install worked. package.ps1 builds the license RTF from LICENSE-MIT and
         LICENSE-APACHE. The finish page offers to launch Local Slides (ticked by default) through
         WixShellExec (WixToolset.Util.wixext); silent installs (/qn) never show it. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Local Slides" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#LocalSlidesExe]" />
    <CustomAction Id="LaunchLocalSlides" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec"
        Impersonate="yes" Return="ignore" />
    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchLocalSlides"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Local Slides" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="Local Slides" Level="1">
      <ComponentGroupRef Id="AppNotices" />
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif?>
      <ComponentGroupRef Id="LocalSlidesFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="AppNotices" Directory="INSTALLFOLDER">
      <Files Include="$(var.AppNoticesDir)\**" />
    </ComponentGroup>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif?>
    <ComponentGroup Id="LocalSlidesFiles" Directory="INSTALLFOLDER">
      <Component Id="LocalSlidesApp" Guid="D87EA444-41A4-4C19-922E-66D1A29461FF">
        <File Id="LocalSlidesExe" Source="$(var.BinDir)\localslides.exe" KeyPath="yes" />

        <!-- .deckcraft: Local Slides' own format; Local Slides is its default app. -->
        <ProgId Id="LocalSlides.Presentation" Description="Local Slides Presentation" Icon="LocalSlidesExe" IconIndex="0">
          <Extension Id="deckcraft" ContentType="application/x-deckcraft">
            <Verb Id="open" Command="Open" TargetFile="LocalSlidesExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <RegistryValue Root="HKMU" Key="Software\Classes\LocalSlides.Presentation\shell\open\command" Value="&quot;[#LocalSlidesExe]&quot; &quot;%1&quot;" Type="string" />
        <!-- PowerPoint formats: offered under "Open with", never forced as the default. -->
        <RegistryValue Root="HKMU" Key="Software\Classes\.pptx\OpenWithProgids" Name="LocalSlides.Presentation" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.potx\OpenWithProgids" Name="LocalSlides.Presentation" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.ppsx\OpenWithProgids" Name="LocalSlides.Presentation" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "localslides"). -->
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localslides.exe" Name="FriendlyAppName" Value="Local Slides" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localslides.exe\shell\open\command" Value="&quot;[#LocalSlidesExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localslides.exe\SupportedTypes" Name=".deckcraft" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localslides.exe\SupportedTypes" Name=".pptx" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localslides.exe\SupportedTypes" Name=".potx" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\localslides.exe\SupportedTypes" Name=".ppsx" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\localslides.exe" Value="[#LocalSlidesExe]" Type="string" />
        <!-- Where this MSI installed the app. The app's own updater reads it under the suite's key
             to know this is an MSI install, so it updates with the new MSI rather than the
             portable zip. HKMU follows the package's scope: HKLM per-machine, HKCU per-user. -->
        <RegistryValue Root="HKMU" Key="Software\Anon5T4R\LocalSlides" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <!-- Shortcuts are plain links to localslides.exe, not advertised MSI shortcuts: advertised
           ones point at a Windows Installer descriptor rather than the program, which Windows
           can't use as a file handler, and Windows Installer caches their icon under its <Icon Id>.
           Each has its own component with an HKLM key path, so Windows Installer removes it on
           uninstall; in the per-machine package both folders are the all-users ones. -->
      <Component Id="LocalSlidesStartMenuShortcut" Directory="ProgramMenuFolder" Guid="6E0C5F34-1D2A-4B7C-9E18-3A4F5B6C7D80">
        <Shortcut Id="StartMenuShortcut" Name="Local Slides" Description="Local Slides presentations and slide shows"
            Target="[#LocalSlidesExe]" WorkingDirectory="INSTALLFOLDER" Icon="LocalSlidesIcon.exe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Anon5T4R\LocalSlides\Shortcuts" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- Search alias: Start Menu search matches the shortcut's name, and every Local app name
           starts with Local — a plain "slides" finds nothing. Same exe, same icon, own component so
           uninstall removes it. -->
      <Component Id="LocalSlidesAliasShortcut" Directory="ProgramMenuFolder" Guid="9A1B2C3D-4E5F-4A6B-8C7D-0E1F2A3B4C5D">
        <Shortcut Id="AliasShortcut" Name="Slides" Description="Local Slides presentations and slide shows"
            Target="[#LocalSlidesExe]" WorkingDirectory="INSTALLFOLDER" Icon="LocalSlidesIcon.exe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Anon5T4R\LocalSlides\Shortcuts" Name="Alias" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="LocalSlidesDesktopShortcut" Directory="DesktopFolder" Guid="3F5E7A9B-0C1D-4E2F-8A3B-5C6D7E8F9A0B">
        <Shortcut Id="DesktopShortcut" Name="Local Slides" Description="Local Slides presentations and slide shows"
            Target="[#LocalSlidesExe]" WorkingDirectory="INSTALLFOLDER" Icon="LocalSlidesIcon.exe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Anon5T4R\LocalSlides\Shortcuts" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="LocalSlidesCli">
        <File Id="LocalSlidesCliExe" Source="$(var.BinDir)\localslides-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
